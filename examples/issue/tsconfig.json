{
  "compilerOptions": {
    "target": "esnext",
    "module": "preserve",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "types": ["bun"],
    "outDir": "../../.moon/cache/types/examples/issue"
  },
  "include": [".kojo/**/*.ts", "tests/**/*.ts", "vitest.config.ts"]
}
