{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "allowJs": true,
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "exactOptionalPropertyTypes": true,
    "stripInternal": true,
    "lib": ["esnext", "dom", "dom.iterable"],
    "types": ["node", "vite/client"],
    "paths": {
      "@/*": ["./src/*"]
    },
    "outDir": "../../.moon/cache/types/apps/visualizer"
  },
  "include": ["src/**/*", "tests/**/*", "*.ts", "*.tsx"],
  "references": [
    {
      "path": "../../packages/control"
    },
    {
      "path": "../../tests/support"
    }
  ]
}
