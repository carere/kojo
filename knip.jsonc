{
  "$schema": "https://unpkg.com/knip@6/schema.json",

  // `includeEntryExports` is what makes this a dead-code check at all, and it is not optional here.
  //
  // The published package declares `"exports": { "./*": "./src/*.ts" }` — every source file is a
  // deep-import entry point, which is the promise the no-barrel rule makes to consumers. The side
  // effect is that knip can never report a file under `src/` as unused: an entry point is reachable
  // by definition. Without this option knip runs clean over the whole source tree no matter what is
  // in it, which is worse than not running it — three separate agents read that green as proof
  // their code was reachable, and it proved nothing.
  //
  // Turning it on moves the question from "is this file reachable" to "is this export used", which
  // is the answerable one for a deep-import library. Verified by mutation: an unused export under
  // `src/` is reported, and the real tree is clean.
  //
  // The escape hatch for something deliberately public that nothing internal uses is the JSDoc
  // `@public` tag on the export. Also verified: `@public` suppresses the finding, `@internal` does
  // not. Reach for it only when an export really is consumer surface — the default answer to an
  // unused export is to delete it.
  "includeEntryExports": true,

  // An export used only inside its own file is a local, not a public surface.
  "ignoreExportsUsedInFile": true,

  // Biome is invoked by moon and by the git hooks rather than imported.
  //
  // `@carere/kojo` is the repository's CLI dependency. Factory source imports its authoring API
  // from `@carere/kojo-runtime`, so no TypeScript module imports the CLI package.
  "ignoreDependencies": ["@biomejs/biome", "@carere/kojo"],

  "workspaces": {
    ".": {
      // The Daemon captures Kojo's own Factory by path, so nothing in this repository imports its
      // top-level Workflow.
      //
      // Only the top-level workflow is named. Everything else under `.kojo/` is reached from it, so
      // a lane or a check that stops being imported is still reported, which is the answer wanted:
      // an orphaned lane is dead code exactly like any other.
      "entry": [".kojo/workflows/factory.ts"]
    },
    "packages/kojo": {
      // The scripts are Moon task entry points. The managed LaunchAgent starts the launcher entry
      // through its immutable bundle. The browser tier starts its isolated Daemon and grant client
      // from Playwright command strings. The native Host controller starts the logout fixture from
      // a real SSH/PAM session. No TypeScript module imports these programs.
      "entry": [
        "src/scripts/*.ts",
        "src/launcher/main.ts",
        "tests/support/daemon/authenticatedConsoleServer.ts",
        "tests/support/daemon/consoleGrant.ts",
        "tests/support/daemon/systemdLogoutFixture.ts"
      ]
    },
    "packages/kojo-runtime": {
      // Imported only by the fresh Runner-process tests through an exact filesystem registration.
      "ignoreFiles": ["tests/fixtures/runner/**"]
    }
  }
}
